{
  "name": "@thinker-workbench/engine",
  "version": "0.1.0",
  "private": true,
  "main": "artifacts/index.js",
  "types": "artifacts/index.d.ts",
  "exports": {
    ".": {
      "types": "./artifacts/index.d.ts",
      "default": "./artifacts/index.js"
    },
    "./entry": {
      "types": "./artifacts/entry.d.ts",
      "default": "./artifacts/entry.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && pnpm run bundle:entry",
    "bundle:entry": "esbuild src/entry.ts --bundle --platform=node --format=cjs --external:better-sqlite3 --outfile=artifacts/entry.js",
    "dev:tsc": "node ../../scripts/run-quiet.mjs -- tsc -p tsconfig.json --watch --preserveWatchOutput",
    "dev:esbuild": "esbuild src/entry.ts --bundle --platform=node --format=cjs --external:better-sqlite3 --outfile=artifacts/entry.js --watch --log-level=warning",
    "dev": "npx --yes concurrently -k --kill-signal SIGKILL \"pnpm:dev:tsc\" \"pnpm:dev:esbuild\"",
    "test": "pnpm -w exec vitest run packages/engine/tests"
  },
  "dependencies": {
    "@langchain/core": "^1.2.17",
    "@langchain/langgraph": "^1.5.0",
    "@langchain/langgraph-checkpoint-sqlite": "^1.1.0",
    "@langchain/openai": "^1.6.2",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@thinker-workbench/file-parsers": "workspace:*",
    "@thinker-workbench/shared": "workspace:*",
    "better-sqlite3": "12.11.1",
    "gpt-tokenizer": "^4.0.0",
    "undici": "^6.29.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "esbuild": "^0.28.2"
  }
}
