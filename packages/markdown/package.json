{
  "name": "@thinker-workbench/markdown",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "artifacts/index.js",
  "types": "artifacts/index.d.ts",
  "exports": {
    ".": {
      "types": "./artifacts/index.d.ts",
      "import": "./artifacts/index.js",
      "default": "./artifacts/index.js"
    },
    "./react": {
      "types": "./artifacts/react/index.d.ts",
      "import": "./artifacts/react/index.js",
      "default": "./artifacts/react/index.js"
    },
    "./styles.less": "./src/styles/markdown.less",
    "./notes.less": "./src/styles/notes.less"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch --preserveWatchOutput",
    "test": "tsc -p tsconfig.json && tsx --test src/parse/syntax.test.ts"
  },
  "dependencies": {
    "highlight.js": "^11.11.1",
    "katex": "^0.19.0",
    "mermaid": "^11.6.0"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^5.7.3"
  }
}
